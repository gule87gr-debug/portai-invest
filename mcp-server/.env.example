# Copy to `.env` and fill in your key. Never commit `.env`.

# Tavily API key — get one at https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# Optional: colon-separated absolute paths that read_file may access.
# Defaults to the user's home directory if unset.
# Example: MCP_READ_ROOTS=/Users/you/Documents:/Users/you/Projects
MCP_READ_ROOTS=
